{
  "name": "musa-muslim-guide",
  "version": "1.0.0",
  "private": true,
  "description": "The Muslim Guide to PolyU, generated from content.md",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/parse.mjs",
    "check": "node scripts/validate.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "test": "npm run build && playwright test",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "links": "node scripts/check-links.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "pdf": "node scripts/make-pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
